# ─────────────────────────────────────────────────────────────
# Run mode. "demo" (default) runs entirely in the browser on
# localStorage with seeded example data. "live" uses Supabase.
# ─────────────────────────────────────────────────────────────
VITE_MODE=demo

# Demo-mode gate password. This is NOT real security — it only
# hides the demo behind a shared word for portfolio/sales use.
VITE_DEMO_PASSWORD=demo

# ─────────────────────────────────────────────────────────────
# Live mode (Supabase). Required only when VITE_MODE=live.
# Find these in your Supabase project: Settings → API.
# ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
